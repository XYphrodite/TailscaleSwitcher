<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TailscaleSwitcher</RootNamespace>
    <AssemblyName>TailscaleSwitcher</AssemblyName>
    <Product>TailscaleSwitcher</Product>
    <AssemblyTitle>TailscaleSwitcher</AssemblyTitle>
    <Description>Tailscale Switcher — управление exit-node, маршрутизацией и прокси в Tailnet</Description>
    <ApplicationIcon>Assets\TailscaleSwitcher.ico</ApplicationIcon>
    <Version>0.5.8</Version>
    <InformationalVersion>0.5.8</InformationalVersion>
    <AssemblyVersion>0.5.8.0</AssemblyVersion>
    <FileVersion>0.5.8.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Resource Include="Assets\TailscaleSwitcher.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TailscaleSwitcher.Tests" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
