<Window x:Class="TailscaleSwitcher.ProfileWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новый профиль выходного ПК"
        Icon="pack://application:,,,/Assets/TailscaleSwitcher.ico"
        Width="560" Height="640" MinWidth="500" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#10141D" Foreground="#F1F5FA"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="WizardTitle" Text="НОВЫЙ ПРОФИЛЬ ВЫХОДНОГО УЗЛА" Foreground="#61E8BA" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Настройка подключения к другому ПК" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,4"/>
            <TextBlock Text="На выходном ПК открой вкладку «Этот ПК (Relay)» и скопируй команду подключения — или выбери ПК из сети Tailnet."
                       Foreground="#929FB4" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <!-- Quick paste -->
                <Border Background="#1B2331" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="БЫСТРАЯ ВСТАВКА КОМАНДЫ ИЗ RELAY" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="Вставь строку `TailscaleSwitcher route profile add ...` — все поля заполнятся сами:"
                                   Foreground="#929FB4" FontSize="11" Margin="0,3,0,8" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ImportBox" Style="{StaticResource DarkTextBox}" TextChanged="OnImportTextChanged"/>
                            <Button Grid.Column="1" Content="Вставить" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="OnPasteImportClick"/>
                        </Grid>
                        <TextBlock x:Name="ImportHint" Foreground="#929FB4" FontSize="11" Margin="0,5,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Main fields -->
                <Border Background="#1B2331" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="ПАРАМЕТРЫ УЗЛА" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Название профиля" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="NameBox" Style="{StaticResource DarkTextBox}" Text="club"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Порт" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="PortBox" Style="{StaticResource DarkTextBox}" Text="1081"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Выбрать компьютер из Tailnet (необязательно)" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PeerCombo" Style="{StaticResource DarkComboBox}" Margin="0,0,0,10" SelectionChanged="OnPeerSelected"/>

                        <TextBlock Text="Tailscale IP выходного ПК" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NodeBox" Style="{StaticResource DarkTextBox}"/>
                            <Button x:Name="ProbeButton" Grid.Column="1" Content="Проверить связь" Style="{StaticResource SmallButton}" Margin="8,0,0,0" Click="OnProbeClick"/>
                        </Grid>
                        <TextBlock x:Name="ProbeLabel" FontSize="11" Margin="0,-4,0,8" Visibility="Collapsed"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Логин" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="UserBox" Style="{StaticResource DarkTextBox}" Text="club"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Пароль (из relay init)" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                <TextBox x:Name="PassBox" Style="{StaticResource DarkTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Режим по умолчанию" Foreground="#929FB4" FontSize="12" Margin="0,2,0,6"/>
                        <RadioButton x:Name="ModeSelectiveRadio" Content="Только выбранные программы и сайты (рекомендуется)" IsChecked="True" Foreground="#F1F5FA" Margin="0,0,0,4"/>
                        <RadioButton x:Name="ModeAllRadio" Content="Весь трафик компьютера (кроме исключений)" Foreground="#F1F5FA"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="ErrorLabel" Foreground="#FF8A80" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnCancelClick"/>
                <Button Content="Создать профиль" Style="{StaticResource PrimaryButton}" Click="OnSaveClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
