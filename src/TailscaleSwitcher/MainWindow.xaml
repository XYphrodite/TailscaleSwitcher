<Window x:Class="TailscaleSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Tailscale Switcher"
        Icon="pack://application:,,,/Assets/TailscaleSwitcher.ico"
        Width="1000" Height="720" MinWidth="900" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#10141D" Foreground="#F1F5FA"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Полоса окна (36px): заголовок + кнопки свернуть/развернуть/закрыть ── -->
        <Grid Grid.Row="0" Background="#10141D">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="TAILSCALE SWITCHER" FontSize="11" FontWeight="Bold" Foreground="#61E8BA" VerticalAlignment="Center"/>
                <TextBlock x:Name="VersionLabel" Text="v0.5.0" FontSize="11" Foreground="#929FB4" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="MinButton" Width="46" Height="36" Background="Transparent" FontSize="13" Content="—" Click="OnMinimizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="MaxButton" Width="46" Height="36" Background="Transparent" FontSize="13" Content="▢" Click="OnMaximizeClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                <Button x:Name="CloseButton" Width="46" Height="36" Background="Transparent" FontSize="13" Content="✕" Click="OnCloseClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>
        </Grid>

        <!-- ── Шапка: имя ПК, Tailscale IP, права, обновления ── -->
        <Grid Grid.Row="1" Margin="18,12,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Управление выходом в интернет через Tailnet" FontSize="19" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Border x:Name="MachinePill" Background="#1B2331" CornerRadius="9" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="MachineLabel" Text="ПК: —" Foreground="#C8D0DA" FontSize="11"/>
                    </Border>
                    <Border x:Name="IpPill" Background="#1B2331" CornerRadius="9" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="IpLabel" Text="Tailscale IP: —" Foreground="#C8D0DA" FontSize="11"/>
                    </Border>
                    <Border x:Name="AdminPill" Background="#3D321B" CornerRadius="9" Padding="10,4">
                        <TextBlock x:Name="AdminLabel" Text="Обычные права" Foreground="#FFD166" FontSize="11"/>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AdminRestartButton" Content="Перезапустить от Администратора" Style="{StaticResource WarningButton}" Click="OnAdminRestartClick" Margin="0,0,8,0"/>
                <Button Content="Обновить" Style="{StaticResource PrimaryButton}" Click="OnRefreshClick"/>
            </StackPanel>
        </Grid>

        <!-- ── Вкладки ── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="18,0,18,10">
            <RadioButton x:Name="TabOverview" Content="Обзор" Style="{StaticResource NavTab}" GroupName="Nav" IsChecked="True" Checked="OnTabChecked"/>
            <RadioButton x:Name="TabRouting" Content="Маршрутизация" Style="{StaticResource NavTab}" GroupName="Nav" Checked="OnTabChecked"/>
            <RadioButton x:Name="TabExit" Content="Exit-node" Style="{StaticResource NavTab}" GroupName="Nav" Checked="OnTabChecked"/>
            <RadioButton x:Name="TabRelay" Content="Этот ПК (Relay)" Style="{StaticResource NavTab}" GroupName="Nav" Checked="OnTabChecked"/>
            <RadioButton x:Name="TabLog" Content="Журнал" Style="{StaticResource NavTab}" GroupName="Nav" Checked="OnTabChecked"/>
        </StackPanel>

        <!-- ── Содержимое вкладок ── -->
        <Grid Grid.Row="3" Margin="18,0,18,0">

            <!-- ═══ ОБЗОР ═══ -->
            <ScrollViewer x:Name="PanelOverview" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#1B2331" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="СЕЙЧАС ТРАФИК ИДЁТ" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="HeroTitle" Text="Напрямую — без узлов и прокси" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,2"/>
                                <TextBlock x:Name="HeroDetail" Text="" Foreground="#929FB4" FontSize="12" TextWrapping="Wrap"/>
                                <TextBlock x:Name="HeroIpLine" Text="Внешний IP: не проверялся" Foreground="#929FB4" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Проверить внешний IP" Style="{StaticResource SmallButton}" Click="OnCheckIpClick" Margin="0,0,8,0"/>
                                <Button Content="Прямой выход" Style="{StaticResource PrimaryButton}" Click="OnGoDirectClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="3">
                        <!-- Карточка: маршрутизация -->
                        <Border Background="#1B2331" CornerRadius="14" Padding="16" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="МАРШРУТИЗАЦИЯ ЧЕРЕЗ УЗЕЛ" Foreground="#929FB4" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RouteStateLabel" Text="Выключена" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                <TextBlock x:Name="RouteDetailLabel" Text="Профиль не выбран" Foreground="#929FB4" FontSize="11" TextWrapping="Wrap" MinHeight="30"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="RouteToggle" Style="{StaticResource ToggleSwitch}" Click="OnRouteToggleClick"/>
                                    <Button Content="Настроить" Style="{StaticResource SmallButton}" Click="OnGoRoutingClick" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Карточка: exit-node -->
                        <Border Background="#1B2331" CornerRadius="14" Padding="16" Margin="4,0">
                            <StackPanel>
                                <TextBlock Text="TAILSCALE EXIT-NODE" Foreground="#929FB4" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ExitStateLabel" Text="Не подключён" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                <TextBlock x:Name="ExitDetailLabel" Text="Трафик идёт напрямую" Foreground="#929FB4" FontSize="11" TextWrapping="Wrap" MinHeight="30"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Выбрать узел" Style="{StaticResource SmallButton}" Click="OnGoExitClick"/>
                                    <Button x:Name="ExitOffButton" Content="Отключить" Style="{StaticResource DangerButton}" Click="OnExitOffClick" Margin="8,0,0,0" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Карточка: прокси Xeon -->
                        <Border Background="#1B2331" CornerRadius="14" Padding="16" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="СИСТЕМНЫЙ ПРОКСИ XEON (HAPP)" Foreground="#929FB4" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ProxyStateLabel" Text="Выключен" FontSize="17" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                <TextBlock x:Name="ProxyDetailLabel" Text="Системный прокси Windows выключен" Foreground="#929FB4" FontSize="11" TextWrapping="Wrap" MinHeight="30"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="ProxyToggle" Style="{StaticResource ToggleSwitch}" Click="OnProxyToggleClick"/>
                                    <Button Content="Проверить" Style="{StaticResource SmallButton}" Click="OnProxyCheckClick" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ МАРШРУТИЗАЦИЯ ═══ -->
            <ScrollViewer x:Name="PanelRouting" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <!-- Шаг 1 -->
                    <Border Background="#1B2331" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ШАГ 1 — ПРОФИЛЬ ВЫХОДНОГО УЗЛА" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Выбери ПК, через который пойдёт трафик. Нового ПК можно добавить мастером." Foreground="#929FB4" FontSize="11" Margin="0,3,0,8" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="ProfileCombo" Style="{StaticResource DarkComboBox}" SelectionChanged="OnProfileSelectionChanged"/>
                                <Button Grid.Column="1" Content="Изменить" Style="{StaticResource SmallButton}" Click="OnProfileEditClick" Margin="8,0,0,0"/>
                                <Button Grid.Column="2" Content="Новый профиль" Style="{StaticResource PrimaryButton}" Click="OnProfileAddClick" Margin="8,0,0,0"/>
                                <Button Grid.Column="3" Content="Удалить" Style="{StaticResource DangerButton}" Click="OnProfileDeleteClick" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock x:Name="ProfileInfoLabel" Text="Профилей пока нет — нажми «Новый профиль»." Foreground="#929FB4" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B2331" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ИСКЛЮЧЕНИЯ" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Включённый набор идёт мимо узла, напрямую — чтобы zapret его видел. Не зависит от профиля маршрута." Foreground="#929FB4" FontSize="11" Margin="0,3,0,8" TextWrapping="Wrap"/>
                            <StackPanel x:Name="ExclusionList"/>
                        </StackPanel>
                    </Border>

                    <!-- Шаг 2 -->
                    <Border Background="#1B2331" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ШАГ 2 — ЧТО НАПРАВЛЯТЬ ЧЕРЕЗ УЗЕЛ" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                            <RadioButton x:Name="ModeSelectiveRadio" Content="Только выбранные программы и сайты (рекомендуется)" Foreground="#F1F5FA" GroupName="RouteMode" IsChecked="True" Checked="OnModeChanged" Margin="0,8,0,4"/>
                            <RadioButton x:Name="ModeAllRadio" Content="Весь трафик компьютера (кроме исключений)" Foreground="#F1F5FA" GroupName="RouteMode" Checked="OnModeChanged"/>

                            <!-- Выборочная маршрутизация -->
                            <Grid x:Name="SelectiveSection" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Программы" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                    <ListBox x:Name="AppsList" Background="#10141D" Foreground="#F1F5FA" BorderBrush="#2D3A50" BorderThickness="1" Height="110" FontSize="12"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="AppAddBox" Style="{StaticResource DarkTextBox}" ToolTip="chrome.exe или C:\путь\app.exe"/>
                                        <Button Grid.Column="1" Content="＋" Style="{StaticResource SmallButton}" Click="OnAppAddClick" Margin="6,0,0,0" Width="34"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Из запущенных" Style="{StaticResource SmallButton}" Click="OnAppFromRunningClick"/>
                                        <Button Content="Убрать" Style="{StaticResource SmallButton}" Click="OnAppRemoveClick" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Сайты и адреса" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                    <ListBox x:Name="HostsList" Background="#10141D" Foreground="#F1F5FA" BorderBrush="#2D3A50" BorderThickness="1" Height="110" FontSize="12"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="HostAddBox" Style="{StaticResource DarkTextBox}" ToolTip="example.com | full:host | 1.2.3.4 | 10.0.0.0/8"/>
                                        <Button Grid.Column="1" Content="＋" Style="{StaticResource SmallButton}" Click="OnHostAddClick" Margin="6,0,0,0" Width="34"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Убрать" Style="{StaticResource SmallButton}" Click="OnHostRemoveClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <!-- Исключения для режима «весь трафик» -->
                            <Grid x:Name="AllSection" Margin="0,10,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="НЕ через узел: программы" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                    <ListBox x:Name="BypassAppsList" Background="#10141D" Foreground="#F1F5FA" BorderBrush="#2D3A50" BorderThickness="1" Height="110" FontSize="12"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BypassAppAddBox" Style="{StaticResource DarkTextBox}"/>
                                        <Button Grid.Column="1" Content="＋" Style="{StaticResource SmallButton}" Click="OnBypassAppAddClick" Margin="6,0,0,0" Width="34"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Убрать" Style="{StaticResource SmallButton}" Click="OnBypassAppRemoveClick"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="НЕ через узел: адреса" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                    <ListBox x:Name="BypassHostsList" Background="#10141D" Foreground="#F1F5FA" BorderBrush="#2D3A50" BorderThickness="1" Height="110" FontSize="12"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="BypassHostAddBox" Style="{StaticResource DarkTextBox}"/>
                                        <Button Grid.Column="1" Content="＋" Style="{StaticResource SmallButton}" Click="OnBypassHostAddClick" Margin="6,0,0,0" Width="34"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button Content="Убрать" Style="{StaticResource SmallButton}" Click="OnBypassHostRemoveClick"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Шаг 3 -->
                    <Border Background="#1B2331" CornerRadius="14" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ШАГ 3 — ВКЛЮЧИТЬ" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RoutePowerLabel" Text="Маршрутизация выключена" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                <TextBlock x:Name="RouteProbeLabel" Text="Relay на выходном ПК не проверялся" Foreground="#929FB4" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Проверить связь с узлом" Style="{StaticResource SmallButton}" Click="OnRouteProbeClick" Margin="0,0,8,0"/>
                                <Button x:Name="RoutePowerButton" Content="Включить маршрутизацию" Style="{StaticResource PrimaryButton}" Click="OnRoutePowerClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ EXIT-NODE ═══ -->
            <ScrollViewer x:Name="PanelExit" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="#1B2331" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ВЫХОД ЧЕРЕЗ ДРУГОЙ ПК TAILNET" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Весь трафик компьютера пойдёт через выбранный узел Tailnet (классический exit-node Tailscale)." Foreground="#929FB4" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap"/>
                            <TextBlock Text="Доступные узлы" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="ExitNodesCombo" Style="{StaticResource DarkComboBox}"/>
                            <CheckBox x:Name="AllowLanCheck" Content="Разрешить доступ к локальной сети (LAN)" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,10,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="ExitConnectButton" Content="Подключить" Style="{StaticResource PrimaryButton}" Click="OnExitConnectClick"/>
                                <Button x:Name="ExitDisconnectButton" Content="Отключить" Style="{StaticResource DangerButton}" Click="OnExitDisconnectClick" Margin="8,0,0,0"/>
                                <Button Content="Обновить список" Style="{StaticResource SmallButton}" Click="OnExitRefreshClick" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="ExitStatusLabel" Text="" Foreground="#929FB4" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B2331" CornerRadius="14" Padding="16">
                        <StackPanel>
                            <TextBlock Text="БЫСТРЫЙ ФИКС" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Авто-фикс «Happ + exit-node»: добавляет маршруты до серверов Happ и включает exit-node xeon (100.119.48.15)." Foreground="#929FB4" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Авто-фикс Happ + exit-node" Style="{StaticResource WarningButton}" Click="OnAutoFixClick"/>
                                <Button Content="Открыть админку Tailnet" Style="{StaticResource SmallButton}" Click="OnOpenAdminClick" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ RELAY (ЭТОТ ПК) ═══ -->
            <ScrollViewer x:Name="PanelRelay" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Background="#1B2331" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ЭТОТ ПК КАК ВЫХОДНОЙ УЗЕЛ (RELAY)" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Здесь ПК принимает трафик других компьютеров Tailnet. Обычно relay ставят на клубный/домашний ПК с рабочим интернетом." Foreground="#929FB4" FontSize="11" Margin="0,3,0,10" TextWrapping="Wrap"/>
                            <TextBlock x:Name="RelayStatusLabel" Text="Relay остановлен" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RelayListenLabel" Text="" Foreground="#929FB4" FontSize="11" Margin="0,3,0,8"/>
                            <TextBlock Text="ПОДКЛЮЧЕНЫ СЕЙЧАС" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                            <ListBox x:Name="RelayClientsList" Background="#10141D" Foreground="#F1F5FA" BorderBrush="#2D3A50" BorderThickness="1" Height="88" FontSize="12" Margin="0,6,0,0" Visibility="Collapsed"/>
                            <TextBlock x:Name="RelayClientsEmpty" Text="Никто не подключён" Foreground="#929FB4" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B2331" CornerRadius="14" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="ПАРАМЕТРЫ" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Порт" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="RelayPortBox" Style="{StaticResource DarkTextBox}" Text="1081"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Логин" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="RelayUserBox" Style="{StaticResource DarkTextBox}" Text="club"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Апстрим (Happ или direct)" Foreground="#929FB4" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="RelayUpstreamBox" Style="{StaticResource DarkTextBox}" Text="127.0.0.1:10809"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сохранить параметры" Style="{StaticResource SmallButton}" Click="OnRelayInitClick"/>
                                <Button Content="Запустить" Style="{StaticResource PrimaryButton}" Click="OnRelayStartClick" Margin="8,0,0,0"/>
                                <Button Content="Запустить с автозапуском" Style="{StaticResource SmallButton}" Click="OnRelayPersistClick" Margin="8,0,0,0"/>
                                <Button Content="Остановить" Style="{StaticResource SmallButton}" Click="OnRelayStopClick" Margin="8,0,0,0"/>
                                <Button Content="Убрать автозапуск" Style="{StaticResource DangerButton}" Click="OnRelayUninstallClick" Margin="8,0,0,0"/>
                                <Button Content="Firewall" Style="{StaticResource WarningButton}" Click="OnRelayFirewallClick" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1B2331" CornerRadius="14" Padding="16">
                        <StackPanel>
                            <TextBlock Text="КОМАНДА ДЛЯ КЛИЕНТА" Foreground="#61E8BA" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="Скопируй её и выполни на другом ПК (или вставь в мастере «Новый профиль»)." Foreground="#929FB4" FontSize="11" Margin="0,3,0,8" TextWrapping="Wrap"/>
                            <TextBox x:Name="RelayInfoBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Показать команду" Style="{StaticResource SmallButton}" Click="OnRelayInfoClick"/>
                                <Button Content="Скопировать" Style="{StaticResource SmallButton}" Click="OnRelayCopyClick" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══ ЖУРНАЛ ═══ -->
            <Grid x:Name="PanelLog" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="LogBox" Grid.Row="0" Style="{StaticResource DarkTextBox}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Top"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Скопировать" Style="{StaticResource SmallButton}" Click="OnLogCopyClick"/>
                    <Button Content="Очистить" Style="{StaticResource SmallButton}" Click="OnLogClearClick" Margin="8,0,0,0"/>
                    <Button Content="Хвост лога маршрутизации" Style="{StaticResource SmallButton}" Click="OnLogClientTailClick" Margin="8,0,0,0"/>
                    <Button Content="Хвост лога relay" Style="{StaticResource SmallButton}" Click="OnLogRelayTailClick" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ── Статус-строка ── -->
        <Grid Grid.Row="4" Margin="18,10,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Готово" Foreground="#929FB4" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ProgressBar x:Name="BusyBar" Grid.Column="1" Width="120" Height="6" IsIndeterminate="True" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
