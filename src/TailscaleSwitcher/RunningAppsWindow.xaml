<Window x:Class="TailscaleSwitcher.RunningAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор запущенного приложения"
        Icon="pack://application:,,,/Assets/TailscaleSwitcher.ico"
        Width="480" Height="520" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#10141D" Foreground="#F1F5FA"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="ЗАПУЩЕННЫЕ ПРОГРАММЫ" Foreground="#61E8BA" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Выбери программу из списка открытых окон" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBox x:Name="SearchBox" Grid.Row="1" Style="{StaticResource DarkTextBox}" Margin="0,0,0,10"
                 TextChanged="OnSearchChanged" ToolTip="Фильтр по имени .exe или заголовку окна"/>

        <Border Grid.Row="2" Background="#1B2331" CornerRadius="12" Padding="6">
            <ListBox x:Name="AppsList" Background="Transparent" BorderThickness="0" Foreground="#F1F5FA"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="OnListDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,7"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#253146"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#2B3D57"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Обновить" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnRefreshClick"/>
            <Button Content="Отмена" Style="{StaticResource SmallButton}" Margin="0,0,8,0" Click="OnCancelClick"/>
            <Button Content="Добавить выбранное" Style="{StaticResource PrimaryButton}" Click="OnAddClick"/>
        </StackPanel>
    </Grid>
</Window>
